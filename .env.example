# ============================================================
# SteamDT 项目环境变量模板
# ------------------------------------------------------------
# 用法：把本文件复制为 .env，填入你自己的真实凭证。
#   copy .env.example .env
# .env 已在 .gitignore 中排除，不会被提交。
# ============================================================

# ---------- SteamDT 开放平台 ----------
# 申请地址：https://open.steamdt.com
STEAMDT_API_KEY=your_steamdt_api_key_here
STEAMDT_BASE_URL=https://open.steamdt.com

# ---------- 回调服务 ----------
# 异步接口（如磨损查询）的回调地址，需公网可达
CALLBACK_URL=https://your-domain.example/callback
PORT=8080

# ---------- C5 开放平台 ----------
# 申请地址：https://openapi.c5game.com
C5_APP_KEY=your_c5_app_key_here
C5_STEAM_ID=your_steamid64_here

# ---------- C5 网页版 ----------
# 登录 c5game.com 后从浏览器开发者工具复制
C5_WEB_ACCESS_TOKEN=your_nc5_access_token_here
C5_WEB_DEVICE_ID=your_nc5_device_id_here

# ---------- Buff ----------
# 登录 buff.163.com 后从浏览器 Cookie 中复制
# Cookie 名：session / csrf_token
BUFF_SESSION=your_buff_session_here
BUFF_CSRF_TOKEN=your_buff_csrf_token_here
# 完整 Cookie 串（部分旧脚本使用）
BUFF_COOKIE_STRING=session=...; csrf_token=...; game=csgo

# ---------- Steam ----------
# 你的 SteamID64（17 位数字）
STEAM_ID=your_steamid64_here
# 交易链接：https://steamcommunity.com/my/tradeoffers/privacy
STEAM_TRADE_URL=https://steamcommunity.com/tradeoffer/new/?partner=XXXXXX&token=YYYYYY

# ---------- ECO (ECOSteam) 开放平台 ----------
# 申请路径：ECOSteam App → 我的 → 设置 → 账号与安全 → 开放能力申请
ECO_PARTNER_ID=your_eco_partner_id_here
# RSA PKCS8 私钥，去掉头尾标识与换行后的纯 Base64 字符串
ECO_RSA_PRIVATE_KEY=your_eco_rsa_private_key_here
# 网页版 Cookie（clientId / refreshToken / loginToken）
ECO_WEB_COOKIE=clientId=...; refreshToken=...; loginToken=...
